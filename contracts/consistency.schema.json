{
  "$defs": {
    "ApprovedException": {
      "additionalProperties": false,
      "properties": {
        "approved_at": {
          "format": "date-time",
          "title": "Approved At",
          "type": "string"
        },
        "exception_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Exception Id",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "finding_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Finding Fingerprint",
          "type": "string"
        },
        "owner_role": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Role"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "exception_id",
        "finding_fingerprint",
        "reason",
        "expires_at"
      ],
      "title": "ApprovedException",
      "type": "object"
    },
    "ArtifactLocator": {
      "additionalProperties": false,
      "properties": {
        "cell_range": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell Range"
        },
        "end_line": {
          "anyOf": [
            {
              "maximum": 10000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        },
        "heading": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heading"
        },
        "page": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "paragraph": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph"
        },
        "sheet": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet"
        },
        "start_line": {
          "anyOf": [
            {
              "maximum": 10000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Line"
        }
      },
      "title": "ArtifactLocator",
      "type": "object"
    },
    "AssuranceSeverity": {
      "enum": [
        "info",
        "warning",
        "high",
        "critical"
      ],
      "title": "AssuranceSeverity",
      "type": "string"
    },
    "AuthorityPolicy": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "$ref": "#/$defs/AuthoritySide",
          "default": "neutral"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "environment": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Environment"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "policy_id": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
          "title": "Policy Id",
          "type": "string"
        },
        "priority": {
          "default": 100,
          "maximum": 10000,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "property_pattern": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Property Pattern",
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "subject_pattern": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Subject Pattern",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "label",
        "subject_pattern",
        "property_pattern"
      ],
      "title": "AuthorityPolicy",
      "type": "object"
    },
    "AuthoritySide": {
      "enum": [
        "neutral",
        "documentation",
        "observed_system"
      ],
      "title": "AuthoritySide",
      "type": "string"
    },
    "ClaimOrigin": {
      "enum": [
        "deterministic",
        "semantic_suggested",
        "semantic_confirmed"
      ],
      "title": "ClaimOrigin",
      "type": "string"
    },
    "ClaimStatus": {
      "enum": [
        "proposed",
        "confirmed",
        "dismissed"
      ],
      "title": "ClaimStatus",
      "type": "string"
    },
    "ConnectorKind": {
      "enum": [
        "local_files",
        "microsoft_graph",
        "odata",
        "sap",
        "dynamics365",
        "netsuite",
        "microsoft_teams",
        "slack",
        "notion",
        "wms",
        "amazon_fba",
        "github",
        "gitlab",
        "jira",
        "confluence",
        "azure_devops",
        "servicenow",
        "sql",
        "sftp",
        "openapi"
      ],
      "title": "ConnectorKind",
      "type": "string"
    },
    "ConsistencyAttribution": {
      "enum": [
        "neutral",
        "documentation_drift",
        "implementation_drift",
        "configuration_drift",
        "release_drift",
        "approved_exception",
        "ambiguous",
        "access_incomplete"
      ],
      "title": "ConsistencyAttribution",
      "type": "string"
    },
    "ConsistencyCitation": {
      "additionalProperties": false,
      "properties": {
        "connector_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Connector Id",
          "type": "string"
        },
        "environment": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Environment"
        },
        "freshness": {
          "default": "unknown",
          "enum": [
            "current",
            "stale",
            "unknown"
          ],
          "title": "Freshness",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/ArtifactLocator"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "source_kind": {
          "$ref": "#/$defs/ConnectorKind"
        },
        "source_label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Label",
          "type": "string"
        },
        "source_reference": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Reference",
          "type": "string"
        },
        "source_revision": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "connector_id",
        "source_kind",
        "source_label",
        "source_reference",
        "source_revision"
      ],
      "title": "ConsistencyCitation",
      "type": "object"
    },
    "ConsistencyClaimReviewRequest": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "confirm",
            "dismiss"
          ],
          "title": "Action",
          "type": "string"
        },
        "expected_revision": {
          "minimum": 1,
          "title": "Expected Revision",
          "type": "integer"
        }
      },
      "required": [
        "expected_revision",
        "action"
      ],
      "title": "ConsistencyClaimReviewRequest",
      "type": "object"
    },
    "ConsistencyComparison": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "$ref": "#/$defs/ConsistencyAttribution",
          "default": "neutral"
        },
        "authority_policy_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authority Policy Id"
        },
        "comparison_rule": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Comparison Rule",
          "type": "string"
        },
        "expected_value": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Value"
        },
        "expected_value_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Expected Value Sha256",
          "type": "string"
        },
        "explanation": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "likely_impact": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Likely Impact",
          "type": "string"
        },
        "observed_value": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Value"
        },
        "observed_value_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Observed Value Sha256",
          "type": "string"
        },
        "recommended_verification": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Recommended Verification",
          "type": "string"
        }
      },
      "required": [
        "expected_value_sha256",
        "observed_value_sha256",
        "comparison_rule",
        "explanation",
        "likely_impact",
        "recommended_verification"
      ],
      "title": "ConsistencyComparison",
      "type": "object"
    },
    "ConsistencyDashboard": {
      "additionalProperties": false,
      "properties": {
        "ambiguous_findings": {
          "default": 0,
          "minimum": 0,
          "title": "Ambiguous Findings",
          "type": "integer"
