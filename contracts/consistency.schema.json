          "title": "Open Findings",
          "type": "integer"
        },
        "proposed_semantic_claims": {
          "items": {
            "$ref": "#/$defs/DocumentClaim"
          },
          "maxItems": 100,
          "title": "Proposed Semantic Claims",
          "type": "array"
        },
        "recent_findings": {
          "items": {
            "$ref": "#/$defs/ConsistencyFinding"
          },
          "maxItems": 200,
          "title": "Recent Findings",
          "type": "array"
        }
      },
      "title": "ConsistencyDashboard",
      "type": "object"
    },
    "ConsistencyExport": {
      "additionalProperties": false,
