        "finding_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Finding Id",
          "type": "string"
        },
        "fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "mismatch_kind": {
          "$ref": "#/$defs/ConsistencyMismatchKind"
        },
        "observed_fact": {
          "$ref": "#/$defs/ObservedSystemFact"
        },
        "owner_role": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Role"
        },
        "property_name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Property Name",
          "type": "string"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "run_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Run Id",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/AssuranceSeverity"
        },
        "status": {
          "$ref": "#/$defs/ConsistencyFindingStatus",
          "default": "open"
        },
        "subject": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "fingerprint",
        "run_id",
        "mismatch_kind",
        "severity",
        "subject",
        "property_name",
        "document_claim",
        "observed_fact",
        "comparison"
      ],
      "title": "ConsistencyFinding",
      "type": "object"
    },
