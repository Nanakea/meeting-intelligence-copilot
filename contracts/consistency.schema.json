    "ConsistencyFinding": {
      "additionalProperties": false,
      "properties": {
        "affected_solution_node_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Affected Solution Node Ids",
          "type": "array"
